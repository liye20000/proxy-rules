#!name=proxy-rules 白名单分流
#!desc=严格白名单:只把白名单域名走代理、其余全部直连;叠加在你的配置之上、主导全部路由,但不动节点。

[Rule]
# ===== 代理白名单(PROXY = 你在首页选中的节点)=====
